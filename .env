# Application Security
SECRET_KEY=isvante-production-master-secret-pk-2026

# Database
DATABASE_PATH=isvante.db

# WhatsApp Business Integration (Pakistani Format: +923XXXXXXXXX)
# This controls the floating WhatsApp button and automated checkout/product messages
WHATSAPP_NUMBER=+923001234567
CONTACT_PHONE=+92 300 1234567
CONTACT_EMAIL=concierge@isvante.com

# Nationwide Shipping in Pakistan (PKR)
SHIPPING_FEE=250
FREE_SHIPPING_THRESHOLD=5000

# AI Chatbot Integration (Optional - intelligent local fallback active by default)
# Add your Gemini or OpenAI API key here to enable live AI reasoning
AI_PROVIDER=gemini
AI_API_KEY=

# Pakistani Payment Gateway Integrations (Ready for activation)
# Options: cod_only | safepay | jazzcash | easypaisa | payfast
PAYMENT_GATEWAY_PROVIDER=cod_only
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
EASYPAISA_STORE_ID=
